{
  "name": "pagedocs",
  "version": "0.0.1",
  "private": true,
  "description": "PageDocs — online collaborative word editor with .docx import/export",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace api run start:dev",
    "api:build": "npm --workspace api run build",
    "web:dev": "npm --workspace web run start",
    "web:build": "npm --workspace web run build",
    "dev": "concurrently -n api,web -c blue,green \"npm run api:dev\" \"npm run web:dev\"",
    "prisma:generate": "npm --workspace api run prisma:generate",
    "prisma:migrate": "npm --workspace api run prisma:migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
